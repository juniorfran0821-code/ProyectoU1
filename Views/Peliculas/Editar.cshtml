@model ProyectoU1.Models.Pelicula

@{
    ViewData["Title"] = "Editar película";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Películas</a></li>
        <li class="breadcrumb-item active">Editar: @Model.Title</li>
    </ol>
</nav>

<div class="card shadow-sm">
    <div class="card-header bg-warning">
        <h4 class="mb-0">Editar película</h4>
    </div>
    <div class="card-body">
        <form asp-action="Editar" asp-route-id="@Model.FilmId" method="post">
            @Html.AntiForgeryToken()
            @await Html.PartialAsync("_FormularioPelicula", Model)
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-warning">Actualizar</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
