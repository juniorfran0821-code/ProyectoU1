@model IEnumerable<ProyectoU1.Models.Pelicula>

@{
    ViewData["Title"] = "Administración de películas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Películas</h2>
    <a asp-action="Crear" class="btn btn-primary">Nueva película</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Título</th>
                <th>Clasificación</th>
                <th>Tarifa</th>
                <th class="text-center">Copias</th>
                <th class="text-center">Disponibles</th>
                <th class="text-center">Estado</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var pelicula in Model)
            {
                <tr class="@(!pelicula.Activo ? "table-secondary text-muted" : "")">
                    <td>@pelicula.FilmId</td>
                    <td>
                        <a asp-action="Detalle" asp-route-id="@pelicula.FilmId">@pelicula.Title</a>
                    </td>
                    <td>@(pelicula.Rating ?? "—")</td>
                    <td>$@pelicula.RentalRate</td>
                    <td class="text-center">@pelicula.TotalCopias</td>
                    <td class="text-center">
                        @if (pelicula.CopiasDisponibles > 0)
                        {
                            <span class="badge bg-success">@pelicula.CopiasDisponibles</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">0</span>
                        }
                    </td>
                    <td class="text-center">
                        @if (pelicula.Activo)
                        {
                            <span class="badge bg-success">Activa</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactiva</span>
                        }
                    </td>
                    <td class="text-center">
                        <div class="d-flex gap-1 justify-content-center">
                            <a asp-action="Editar" asp-route-id="@pelicula.FilmId"
                               class="btn btn-warning btn-sm">Editar</a>
                            <a asp-controller="Inventario" asp-action="Index"
                               asp-route-filmId="@pelicula.FilmId"
                               class="btn btn-outline-primary btn-sm">Inventario</a>
                            @if (pelicula.Activo)
                            {
                                <form asp-action="Eliminar" asp-route-id="@pelicula.FilmId"
                                      method="post" class="d-inline"
                                      onsubmit="return confirm('¿Desactivar esta película?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-sm">Desactivar</button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="Restaurar" asp-route-id="@pelicula.FilmId"
                                      method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-success btn-sm">Restaurar</button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_Paginacion")
