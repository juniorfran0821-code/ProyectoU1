@model IEnumerable<ProyectoU1.Models.Alquiler>

@{
    ViewData["Title"] = "Todos los alquileres";
}

<h2 class="mb-3">Alquileres</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">No hay alquileres registrados.</div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Película</th>
                <th>Cliente</th>
                <th>Fecha alquiler</th>
                <th>Fecha devolución</th>
                <th class="text-center">Estado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var alquiler in Model)
            {
                <tr>
                    <td>#@alquiler.RentalId</td>
                    <td>@alquiler.TituloPelicula</td>
                    <td>@alquiler.NombreCliente</td>
                    <td>@alquiler.RentalDate.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        @if (alquiler.ReturnDate.HasValue)
                        {
                            @alquiler.ReturnDate.Value.ToString("dd/MM/yyyy HH:mm")
                        }
                        else
                        {
                            <span class="text-warning">Pendiente</span>
                        }
                    </td>
                    <td class="text-center">
                        @if (alquiler.EstaDevuelto)
                        {
                            <span class="badge bg-success">Devuelto</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Activo</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@await Html.PartialAsync("_Paginacion")
